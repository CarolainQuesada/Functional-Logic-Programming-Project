data DiagnosticCode
  = InputFailure
  | MalformedRecord
  | UnknownVocabulary
  | UnknownSection
  | MissingSection
  | RepeatedSection
  | RecordOutsideSection
  | DuplicateEntity
  | UndeclaredReference
  | ArgumentTypeMismatch
  | UnsupportedRule
  | DuplicateRelation
  | CourseWithoutTeacherWarning
  | CourseWithoutStudents
  | PersonWithoutCourses
  | TeacherWithoutCourses
  | CaseSimilarEntity
  | DuplicateRule
  deriving (Eq, Show)
@endcode
